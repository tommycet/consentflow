# ConsentFlow Cleanverse Adapter — environment configuration
# Copy this file to `.env` and fill in your sandbox credentials.
# NEVER commit the real `.env` (it is git-ignored).

# Cleanverse sandbox base URL (UAT). Production: https://api.cleanverse.com/api/cooperate
CLEANVERSE_BASE_URL=https://uatapi.cleanverse.com/api/cooperate

# Cleanverse application ID (api-id header). Fill with your sandbox API ID.
CLEANVERSE_API_ID=

# Cleanverse API key. Base64-encoded 32-byte key used both as the api-key
# header and as the AES-256 key material for encrypted endpoints.
CLEANVERSE_API_KEY=

# Port for the ConsentFlow adapter server (default 4000)
PORT=4000

# Monad testnet A-Token (aUSDC) used as the default `atoken` for CCP verify_apass.
# Override per-request via the body if needed.
CLEANVERSE_DEFAULT_ATOKEN=0xfa96de5b8f434c26fdff953303dd66ff80af1026

# Chain id used in A-Pass / rule payloads (default monad)
CLEANVERSE_CHAIN=monad

# ----- On-chain integration (ethers v6) -----
# Monad testnet RPC (default public endpoint; override with your own if needed)
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Deployer / operator wallet private key ( NEVER commit real keys to git )
DEPLOYER_PRIVATE_KEY=

# Deployed contract addresses (filled after deployment)
CONSENT_REGISTRY_ADDRESS=
CONTRIBUTION_RECEIPT_ADDRESS=
